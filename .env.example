# Copy to .env and fill in. .env is git-ignored — never commit real values.

# mock | angelone
FEED_TYPE=mock

# Angel One SmartAPI credentials (only needed when FEED_TYPE=angelone)
ANGELONE_CLIENT_ID=
ANGELONE_API_KEY=
ANGELONE_TOTP_SECRET=
# Account login PIN/MPIN — SmartConnect.generateSession() requires this
# alongside the TOTP code.
ANGELONE_PIN=
