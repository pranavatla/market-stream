# --- Angel One SmartAPI credentials (required) ---
# Create/get these from your SmartAPI developer portal + Angel One account.
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_MPIN=
# Base32 seed behind your authenticator QR (NOT the 6-digit rotating code)
ANGEL_TOTP_SEED=

# --- Advisory (optional, read-only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
# auto = run A/B and pick winner, claude = force Claude, gemini = force Gemini
ADVISORY_PRIMARY=auto

# --- Risk limits (optional; sane defaults exist) ---
MAX_LOSS_PER_DAY=5000
MAX_LOSS_PER_TRADE=2000
MAX_LOTS_PER_ORDER=2
MAX_OPEN_POSITIONS=2
MAX_ORDERS_PER_DAY=10
ENTRY_START=09:30
ENTRY_CUTOFF=15:00
SQUARE_OFF=15:15

# Verify against current NSE contract spec before live trading
NIFTY_LOT_SIZE=75

# manual = always require UI confirm; auto = (not wired yet; keep manual)
CONFIRM_MODE=manual

# Optional: second factor for LIVE actions (execute/kill/squareoff).
# If set, the dashboard will prompt for it once per browser session.
TRADER_TOKEN=
